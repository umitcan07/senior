@startuml
!theme plain
skinparam dpi 300
skinparam activity {
    BackgroundColor #E1F5FF
    BorderColor #4A90E2
    FontColor #000000
    FontSize 10
}
skinparam defaultFontSize 10
skinparam activityDiamond {
    BackgroundColor #FFF4E1
    BorderColor #E67E22
}
skinparam partition {
    BackgroundColor #F8F9FA
    BorderColor #95A5A6
}

start

:User initiates recording;

:Record audio via browser;

:Convert to WAV\n(16-bit, 16 kHz, mono);
:Store audio in object storage;
:Create recording record in database;
:Queue ML processing job (single endpoint);

partition "ML Processing (POWSM worker)" {
  :Load audio file;
  :Audio-quality gate\n(Silero VAD + SNR);
  if (Confident? speech / right sentence / clean) then (yes)
    :Phone Recognition\n(POWSM + LoRA adapter);
    :CTC forced alignment\n(per-phone timings);
    :Feature-aware diff vs reference\n(PanPhon distance);
    :Per-phone GOP + confidence;
    :Compute scores + feedback;
  else (no)
    :Abstain with reason\n(no-speech / noisy /\nwrong-sentence / uncertain);
  endif
}

:Store analysis results in database;

if (Abstained?) then (no)
  :Show pronunciation score;
  :Highlight per-phone errors\n(GOP colouring);
  :Provide feature-based feedback\n+ educational guidance;
else (yes)
  :Display abstention banner;
  :Suggest re-recording;
endif

stop

@enduml

